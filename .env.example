# The Graph API Keys (comma-separated, get from https://thegraph.com/studio/)
GRAPH_KEYS=your_key_1,your_key_2,your_key_3

# BSC RPC endpoint
BSC_RPC=https://bsc-dataseed.binance.org

# BSC RPC for log queries (separate provider, avoids rate limits)
LOG_RPC=https://bsc-rpc.publicnode.com

# Wallets to monitor (JSON array)
WALLETS=[{"address":"0x...","name":"Wallet 1"},{"address":"0x...","name":"Wallet 2"}]

# Server port
PORT=5179

# Solana RPC 主节点: 填 helius 即展开为 mainnet.helius-rpc.com?api-key=<HELIUS_KEY> (2026-10-15 起主节点用 Helius 免费档, 每账号 1M 积分/月, 10 req/s)
#   sol-rpc.js 对 Helius 自动: 限速 (SOL_RPC_RPS 默认 9, gPA 4/s, Enhanced 2/s) + getProgramAccounts→V2 (10→1 积分) + 积分计量 (helius-meter-sol.json, 估算值, 按 key 分账)
#   5 分钟一轮仓位 ≈ 80 积分 (≈69 万/月) + 账本每 30 分钟每钱包 ≥1 页 Enhanced 解析 (100 积分/页, ≈30 万/月) ≈ 100 万/月 → 单账号刚好不够, 配第二把 key 接力
#   多账号顺序接力: HELIUS_KEY → HELIUS_KEY_2 → HELIUS_KEY_3 … 同一时刻只用一把, 当前这把月积分用尽 (Helius 回 429 "max usage reached", 或估算 ≥ SOL_HELIUS_BUDGET 默认 1000000)
#   才切下一把 (同一请求原地重发); 用尽的 key 每 SOL_HELIUS_REPROBE_MS (默认 6 小时) 再探一次, 探通就回到靠前那把; 全部用尽 → 仓位轮走备胎, 账本等重置
#   SOL_LEDGER_PRECHECK=1 可开账本预检 (追平态先用 1 积分看有没有新交易, 没有就跳过 100 积分的解析页); 默认关
SOL_RPC=helius
# 备胎: 主节点连续 429 时最后一轮重试切过去; Helius 所有 key 都用尽时仓位轮整轮走备胎
SOL_RPC_FALLBACK=https://public.rpc.solanavibestation.com

# Ethereum 主网 RPC
ETH_RPC=https://ethereum-rpc.publicnode.com

# Robinhood Chain (chainId 4663) RPC
RH_RPC=https://rpc.mainnet.chain.robinhood.com

# Ankr Advanced API key (Freemium 免费档即可): 钱包盈亏账本 Base/Ethereum 的数据源; 留空则这两条链只有开仓时价值、无历史仓位
ANKR_KEY=
# Helius API key (免费档即可): Solana 仓位轮主节点 + 钱包盈亏账本数据源; 留空则 Solana 只有现值/手续费、无成本与历史仓位
HELIUS_KEY=
# 第二/第三个 Helius 账号的 key (可选): 第一把月积分用尽后顺序接力 (见上面 SOL_RPC 说明); 留空 = 单账号
HELIUS_KEY_2=
HELIUS_KEY_3=

# ---- 2026-09-28 审计补齐 (只列键名; 值填 .env, 不要填这里) ----
# 监听地址: 只绑本机, nginx 是唯一入口 (兜底: 即使 nginx 闸门失效, 外网也连不到 5179)。不要改成 0.0.0.0
HOST=127.0.0.1
# 管理口令: 设了以后, 写接口 (改钱包/快照/通知/资金配置等) 须带 x-admin-token 头; 留空 = 不校验, 只靠 nginx 登录闸门
ADMIN_TOKEN=
# Telegram 哨兵 bot (notifier.js 出区间通知); 两个都留空则不发送
TG_BOT_TOKEN=
TG_CHAT_ID=
# Pancake (BSC) 日志扫描用的 RPC 列表 (逗号分隔, 多家轮换); 留空用 pancake-bsc.js 内置默认列表
# Pancake V3 领费/建仓日志扫描 RPC，格式 url@每次块数，逗号分隔按优先级；NodeReal 免费 key 单次可扫 49999 块，强烈建议配上
# PCS_LOG_RPCS=https://bsc-mainnet.nodereal.io/v1/<your_key>@49999,https://bsc.rpc.blxrbdn.com@4999,https://bsc-rpc.publicnode.com@4999
PCS_LOG_RPCS=
# BSC 日志回扫天数 (server.js: 换算成块数分段扫链, 30 天 ≈ 5.76M 块)
LOG_SCAN_LOOKBACK_DAYS=30
# ---- 2026-10-02 ----
# 装了 curl_cffi 的 python 解释器 (cf-get.py 用它仿 Chrome 过 Cloudflare): rh blockscout 在 CF 后面, 原生 ETH 充提 / 账本原生币补查都靠它;
#   留空默认 /home/ubuntu/.venvs/cffi/bin/python (python3 -m venv ~/.venvs/cffi && ~/.venvs/cffi/bin/pip install curl_cffi); 解释器缺失 = 这两项跳过、按旧口径
CFFI_PYTHON=
